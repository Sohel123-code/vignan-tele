# Existing root .env values are also read. Nonempty server settings override them.
PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Root aliases VITE_SUPABASE_URL and SUPABASE_SECRET_KEY are supported server-side.

# Direct Outpero API: no ngrok, lead slug or webhook required.
OUTPERO_MODE=api
OUTPERO_API_URL=https://api.outpero.com/v1
OUTPERO_API_KEY=
# Optional: select/save an Instant/outbound agent inside the campaign instead.
OUTPERO_EMPLOYEE_ID=
OUTPERO_POLL_INTERVAL_MS=5000

ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CALL_DELAY_MS=5000
DEMO_MAX_CONTACTS=5
# Optional extra restriction; otherwise use the admin-confirmed test contacts.
DEMO_ALLOWED_PHONES=

# Optional signed webhook, only for a publicly hosted backend.
OUTPERO_WEBHOOK_SECRET=

# Optional transcript extraction; provider-captured answers need no extra API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Serve the built React app and API from one Node host when true.
SERVE_FRONTEND=false
