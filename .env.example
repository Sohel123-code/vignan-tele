# Supabase project URL: Project Settings > Data API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Project Settings > API Keys > Publishable key (or legacy anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Separate Express backend; use its HTTPS URL in Vercel.
VITE_API_URL=http://localhost:4000

# Never put a service_role, sb_secret key, or admin password in VITE_* variables.
